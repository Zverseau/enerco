RewriteEngine on

# 1. Canonisation de l'hôte : www.enerco-tg.com -> enerco-tg.com (301)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# 2. /dist/... n'est pas une URL publique -> 301 vers l'URL propre.
#    THE_REQUEST ne contient que la requête d'origine : la réécriture
#    interne de la règle 4 ne redéclenche donc pas cette règle.
RewriteCond %{THE_REQUEST} \s/+dist/([^\s?]*) [NC]
RewriteRule ^ /%1 [R=301,L]

# 3. /index.html -> / (une seule URL pour la page d'accueil)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 4. Réécriture interne : le site est servi depuis dist/
RewriteCond %{HTTP_HOST} ^enerco-tg\.com$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.enerco-tg\.com$ [NC]
RewriteCond %{REQUEST_URI} !dist/
RewriteRule (.*) /dist/$1 [L]
